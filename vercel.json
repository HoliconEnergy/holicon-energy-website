{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/knowledge/:article.html",
      "destination": "/:article.html"
    },
    {
      "source": "/aftercare/:brand.html",
      "destination": "/:brand.html"
    }
  ]
}
